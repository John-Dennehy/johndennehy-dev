# -----------------------------------------------------------------------------
# johndennehy.dev - Environment Variables Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to .env.local for local development.
# 2. Fill in the values below.
# 3. DO NOT commit .env.local to version control.
# -----------------------------------------------------------------------------

# --- CORE INFRASTRUCTURE (Server-side) ---

# Neon Postgres - Individual variables (Preferred for Vercel/Neon Integration)
# These are automatically provided by the Neon Vercel integration
PGHOST=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Fallback Neon Postgres connection string
# Production should use ?sslmode=verify-full
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=verify-full"

# Payload CMS secret — used to sign JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET="REPLACE_ME_WITH_32_CHARACTER_STRING"

# Resend API key for transactional email
# Get one at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxx"

# --- APPLICATION URLs (Public) ---

# Public URL of the site — used for CORS, CSRF, and absolute links
# e.g., https://johndennehy.dev or http://localhost:3000
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# --- CONTACT & NOTIFICATIONS ---
    
# Email address to receive contact form submissions
CONTACT_EMAIL="[EMAIL_ADDRESS]"  

# --- ANALYTICS & MONITORING ---

# Vercel Analytics ID (optional)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""
