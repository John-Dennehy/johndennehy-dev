# johndennehy.dev environment variables
# Copy this file to .env and fill in the values

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Payload CMS secret — used to sign JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=YOUR_SECRET_HERE_AT_LEAST_32_CHARS

# Resend API key for transactional email (password resets, etc.)
# Get one free at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Public URL of the site — used for CORS, CSRF, and email links
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
