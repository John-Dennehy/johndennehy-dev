{
	"name": "johndennehy.dev",
	"version": "1.0.0",
	"description": "johndennehy.dev",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"ci": "pnpm run migrate:check && pnpm run migrate && pnpm run build",
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"import:projects": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/import-projects.ts",
		"migrate:check": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/check-migrations.ts",
		"migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
		"migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
		"lint": "biome check .",
		"format": "biome format --write .",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"test": "pnpm run test:int && pnpm run test:e2e",
		"test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
		"test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@payloadcms/db-postgres": "3.90.2",
		"@payloadcms/email-resend": "3.90.2",
		"@payloadcms/next": "3.90.2",
		"@payloadcms/richtext-lexical": "3.90.2",
		"@payloadcms/storage-vercel-blob": "3.90.2",
		"@payloadcms/ui": "3.90.2",
		"@tailwindcss/postcss": "^4.2.2",
		"@vercel/analytics": "^2.0.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "^7.0.3",
		"dotenv": "16.4.7",
		"graphql": "^16.8.1",
		"lucide-react": "^1.8.0",
		"next": "16.3.8",
		"payload": "3.90.2",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"sharp": "0.35.5",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@playwright/test": "1.58.2",
		"@testing-library/react": "16.3.0",
		"@types/node": "22.19.9",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "4.7.0",
		"jsdom": "28.1.0",
		"postcss": "^8.5.31",
		"shadcn": "^4.22.1",
		"tailwindcss": "^4.2.2",
		"tsx": "4.21.0",
		"typescript": "5.7.3",
		"vite-tsconfig-paths": "6.0.5",
		"vitest": "4.1.12"
	},
	"engines": {
		"node": "22.x",
		"pnpm": "^10"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp",
			"esbuild",
			"unrs-resolver"
		],
		"overrides": {
			"payload>undici": "7.29.1",
			"monaco-editor>dompurify": "^3.4.16"
		}
	},
	"packageManager": "pnpm@10.34.6"
}
